def get_student(student_id):

    connection = get_connection()

    row = connection.execute(
        """
        SELECT *
        FROM students
        WHERE student_id = ?
        """,
        (student_id,)
    ).fetchone()

    connection.close()

    return row


def get_all_courses():

    connection = get_connection()

    rows = connection.execute(
        """
        SELECT *
        FROM courses
        ORDER BY course_code
        """
    ).fetchall()

    connection.close()

    return rows


def get_course(course_code):

    connection = get_connection()

    row = connection.execute(
        """
        SELECT *
        FROM courses
        WHERE course_code = ?
        """,
        (course_code,)
    ).fetchone()

    connection.close()

    return row


def get_prerequisites(course_code):

    connection = get_connection()

    rows = connection.execute(
        """
        SELECT
            p.prerequisite_code,
            p.minimum_grade,
            c.course_name

        FROM prerequisites p

        JOIN courses c
        ON p.prerequisite_code = c.course_code

        WHERE p.course_code = ?
        """,
        (course_code,)
    ).fetchall()

    connection.close()

    return rows


def get_completed_courses(student_id):

    connection = get_connection()

    rows = connection.execute(
        """
        SELECT
            cc.course_code,
            c.course_name,
            cc.grade,
            c.credits

        FROM completed_courses cc

        JOIN courses c
        ON cc.course_code = c.course_code

        WHERE cc.student_id = ?

        ORDER BY cc.course_code
        """,
        (student_id,)
    ).fetchall()

    connection.close()

    return rows


def get_registered_courses(student_id):

    connection = get_connection()

    rows = connection.execute(
        """
        SELECT
            r.id,
            r.course_code,
            c.course_name,
            c.credits,
            c.days,
            c.start_time,
            c.end_time,
            r.registration_date,
            r.status

        FROM registrations r

        JOIN courses c
        ON r.course_code = c.course_code

        WHERE
            r.student_id = ?
            AND r.status = 'Registered'

        ORDER BY c.course_code
        """,
        (student_id,)
    ).fetchall()

    connection.close()

    return rows


def add_registration(
    student_id,
    course_code
):

    connection = get_connection()

    cursor = connection.cursor()

    cursor.execute(
        """
        INSERT INTO registrations
        (
            student_id,
            course_code,
            status
        )
        VALUES (?, ?, 'Registered')
        """,
        (
            student_id,
            course_code
        )
    )

    cursor.execute(
        """
        UPDATE courses
        SET enrolled = enrolled + 1
        WHERE course_code = ?
        """,
        (course_code,)
    )

    connection.commit()

    registration_id = cursor.lastrowid

    connection.close()

    return registration_id


def remove_registration(
    student_id,
    course_code
):

    connection = get_connection()

    cursor = connection.cursor()

    cursor.execute(
        """
        UPDATE registrations

        SET status = 'Dropped'

        WHERE
            student_id = ?
            AND course_code = ?
            AND status = 'Registered'
        """,
        (
            student_id,
            course_code
        )
    )

    cursor.execute(
        """
        UPDATE courses

        SET enrolled =
            CASE
                WHEN enrolled > 0
                THEN enrolled - 1
                ELSE 0
            END

        WHERE course_code = ?
        """,
        (course_code,)
    )

    connection.commit()

    connection.close()


def course_exists_in_registration(
    student_id,
    course_code
):

    connection = get_connection()

    count = connection.execute(
        """
        SELECT COUNT(*)

        FROM registrations

        WHERE
            student_id = ?
            AND course_code = ?
            AND status = 'Registered'
        """,
        (
            student_id,
            course_code
        )
    ).fetchone()[0]

    connection.close()

    return count > 0


def add_course(
    course_code,
    course_name,
    department,
    credits,
    semester,
    capacity,
    description,
    days,
    start_time,
    end_time
):

    connection = get_connection()

    connection.execute(
        """
        INSERT INTO courses
        (
            course_code,
            course_name,
            department,
            credits,
            semester,
            capacity,
            enrolled,
            description,
            days,
            start_time,
            end_time
        )

        VALUES
        (
            ?, ?, ?, ?, ?, ?,
            0, ?, ?, ?, ?
        )
        """,
        (
            course_code,
            course_name,
            department,
            credits,
            semester,
            capacity,
            description,
            days,
            start_time,
            end_time
        )
    )

    connection.commit()

    connection.close()
